<dialogueNodes>

    <scene id ="initial">
        <author><![CDATA[AceXp]]></author>
        <preParsingEffects><![CDATA[
			[#flags.setFlag(FLAG_acexp_elis_trader_daily_interaction, true)]
			[##var ElisTraderRnd = RND.nextInt(10)+1]

            [#flags.setSavedLong('AceXpElisTrader', game.importModdedCharacter('res/characters/acexp/Elis_trader.xml', 'AceXpElisTrader'))]
            [#AceXpElisTrader.setTrader(true)]
            [#AceXpElisTrader.setItemTagsToBuy(Array(ITEM_TAG_SOLD_BY_KATE))]
   			[#AceXpElisTrader.clearNonEquippedInventory(false)];

			[#AceXpElisTrader.addClothing(game.getItemGen().generateClothing('WRIST_WOMENS_WATCH', false), RND.nextInt(3)+1, false, false)]
			[#AceXpElisTrader.addClothing(game.getItemGen().generateClothing('WRIST_MENS_WATCH', false), RND.nextInt(3)+1, false, false)]
			[#AceXpElisTrader.addItem(game.getItemGen().generateItem('acexp_pills_sterility'), RND.nextInt(5)+1, false, false)]

   			#IF(ElisTraderRnd<=8)
    		    [#AceXpElisTrader.addClothing(game.getItemGen().generateClothing('innoxia_finger_ring', false), RND.nextInt(3)+1, false, false)]
    		#ENDIF

			[#AceXpElisTrader.setLocation(WORLD_TYPE_EMPTY, PLACE_TYPE_GENERIC_HOLDING_CELL, true)]
		]]></preParsingEffects>
        <content folderPath="txt/acexp/elis/elis_trader">INTRO</content>
        <secondsPassed minutes="true"><![CDATA[5]]></secondsPassed>
        <continuesDialogue>false</continuesDialogue>
        <travelDisabled>true</travelDisabled>
        <inventoryDisabled>true</inventoryDisabled>
